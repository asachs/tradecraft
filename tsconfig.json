{
  "compilerOptions": {
    // Bun runs the TypeScript directly; tsc is only ever a checker here.
    "noEmit": true,
    "allowImportingTsExtensions": true,

    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "types": ["bun"],

    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["tools/**/*.ts", "hooks/**/*.ts", "tests/**/*.ts"]
}
