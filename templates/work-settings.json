{
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/SessionActivityLog.hook.ts"
          },
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/RepeatDetection.hook.ts"
          },
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/ISASync.hook.ts"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/SecurityPipeline.hook.ts"
          },
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/PromptGuard.hook.ts"
          },
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/ContainmentGuard.hook.ts"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/ToolActivityTracker.hook.ts"
          },
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/ContentScanner.hook.ts"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/PreCompact.hook.ts"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bun ~/.claude/hooks/PromptProcessing.hook.ts"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read(**)",
      "Glob(**)",
      "Grep(**)",
      "Edit(~/.claude/**)",
      "Edit(~/work/**)",
      "Edit(~/src/**)",
      "Write(~/.claude/**)",
      "Write(~/work/**)",
      "Write(~/src/**)",
      "Bash"
    ],
    "deny": [
      "Bash(*elevenlabs*)",
      "Bash(*telegram*)",
      "Bash(*t.me/*)",
      "Bash(*localhost:31337*)",
      "Bash(osascript *)"
    ]
  },
  "env": {
    "LIFEOS_DIR": "$HOME/.claude/LIFEOS",
    "WORK_DIR": "$HOME/work",
    "WORK_MODE": "1"
  }
}
